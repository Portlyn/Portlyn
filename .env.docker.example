# Copy this file to `.env.docker` and set real production values.

JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_SIGNING_SECRET=replace-with-a-different-random-32-plus-character-secret
SESSION_BRIDGE_SECRET=replace-with-a-different-random-32-plus-character-secret
OIDC_STATE_SECRET=replace-with-a-different-random-32-plus-character-secret
MFA_ENCRYPTION_SECRET=replace-with-a-different-random-32-plus-character-secret
CSRF_SECRET=replace-with-a-different-random-32-plus-character-secret
DATA_ENCRYPTION_SECRET=replace-with-a-different-random-32-plus-character-secret
DATA_ENCRYPTION_LEGACY_SECRETS=
AUDIT_HMAC_SECRET=replace-with-a-different-random-32-plus-character-secret
JWT_ISSUER=portlyn
APP_VERSION=docker
LOG_LEVEL=info

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
VIEWER_EMAIL=viewer@example.com
VIEWER_PASSWORD=

FRONTEND_BASE_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# Serves the dashboard on the raw server IP on port 80/443 before any domain
# exists. Without it a fresh install answers 404 on the IP and the only way in
# is an SSH tunnel to the API port below.
BOOTSTRAP_ADMIN_ENABLED=true
# Left at false the bootstrap dashboard only answers requests from the server
# itself. Set it to true to open https://<server-ip> in your own browser during
# setup, with a self-signed certificate. Turn it back off once your domain and
# real certificate work.
BOOTSTRAP_ADMIN_ALLOW_REMOTE=false
METRICS_PUBLIC=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
EXPOSE_AUTH_TOKENS=false

PORTLYN_API_PORT=8080
PORTLYN_API_BIND_ADDR=127.0.0.1
PORTLYN_HTTP_PORT=80
PORTLYN_HTTPS_PORT=443
LOKI_PORT=3100
LOKI_BIND_ADDR=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_BIND_ADDR=127.0.0.1

DATABASE_DRIVER=postgres
# Leave DATABASE_URL empty to use the bundled Docker PostgreSQL service.
# Set DATABASE_URL to point to an external PostgreSQL server when needed.
DATABASE_URL=
POSTGRES_DB=portlyn
POSTGRES_USER=portlyn
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

TOKEN_TTL=30m
REFRESH_TOKEN_TTL=720h
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW=10m
AUTH_CACHE_TTL=1m
CSRF_TOKEN_TTL=12h
REQUEST_BODY_LIMIT_BYTES=1048576
AUDIT_BUFFER_SIZE=4096
NODE_OFFLINE_AFTER=2m
NODE_REQUIRE_HTTPS=true
NODE_TRUST_FORWARDED_PROTO=true
NODE_ALLOW_MTLS_HEADER_FALLBACK=false
NODE_ENROLL_RATE_LIMIT=20
NODE_ENROLL_RATE_WINDOW=10m
NODE_HEARTBEAT_AUTH_FAIL_RATE_LIMIT=20
NODE_HEARTBEAT_AUTH_FAIL_RATE_WINDOW=1m
BREAK_GLASS_ENABLED=false
BREAK_GLASS_TOKEN=
BREAK_GLASS_TTL=15m
BREAK_GLASS_ALLOW_CIDRS=127.0.0.1/32,::1/128
ALERT_LOGIN_FAIL_SPIKE_THRESHOLD=20
ALERT_NODE_HEARTBEAT_FAIL_THRESHOLD=20
ALERT_AUDIT_ANOMALY_THRESHOLD=10
ALERT_WINDOW=15m

REDIRECT_HTTP_TO_HTTPS=false
ACME_ENABLED=false
ACME_EMAIL=
ACME_CA_URL=
ACME_POLL_INTERVAL=1m

# DNS-01 challenge. Needed for wildcards, and for any box that cannot take
# inbound traffic on 80/443. Set the provider, then fill in its token below.
# Supported: cloudflare, hetzner, digitalocean, route53.
# You can skip all of this and enter the token in the first-run wizard instead.
ACME_DNS_PROVIDER=
ACME_DNS_CLOUDFLARE_API_TOKEN=
ACME_DNS_HETZNER_API_TOKEN=
ACME_DNS_DIGITALOCEAN_API_TOKEN=
ACME_DNS_ROUTE53_ACCESS_KEY_ID=
ACME_DNS_ROUTE53_SECRET_ACCESS_KEY=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_ADMIN_ROLE_CLAIM_PATH=realm_access.roles
OIDC_ADMIN_ROLE_VALUE=
OIDC_PROVIDER_LABEL=SSO
# Links an OIDC identity to an existing local account by matching email address.
# Only enable with a single, fully trusted IdP that reliably sets email_verified.
# With an IdP that allows self-registration or sets email_verified statically, an
# attacker could register your admin's email there and take over the local account.
OIDC_ALLOW_EMAIL_LINKING=false
OIDC_REQUIRE_VERIFIED_EMAIL=true

OTP_ENABLED=true
OTP_TOKEN_TTL=10m
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW=15m
OTP_RESPONSE_INCLUDES_CODE=false
REQUIRE_MFA_FOR_ADMINS=true

# Allow proxy upstreams on loopback/private networks. Set to false to harden
# against SSRF to internal hosts (only do this if all upstreams are public).
PROXY_ALLOW_PRIVATE_UPSTREAMS=true

ALLOW_INSECURE_DEV_MODE=false
